<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<StackPane prefHeight="720.0" prefWidth="1080.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="boundary.PantallaOrdenController">

    <BorderPane style="-fx-background-color: #ecf0f1;">
        <left>
            <VBox prefWidth="260.0" spacing="0" styleClass="sidebar">
                <padding>
                    <Insets bottom="30" left="20" right="20" top="30" />
                </padding>

                <Label styleClass="sidebar-title" text="CCRS - SISMOLOGÍA" />

                <Region prefHeight="20.0" />

                <VBox spacing="10">
                    <Button maxWidth="Infinity" onAction="#mostrarDashboard" prefHeight="45.0" styleClass="menu-button" text="Dashboard">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@/images/dashboard.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button maxWidth="Infinity" onAction="#mostrarMensajeConstruccion" prefHeight="45.0" styleClass="menu-button" text="Mapa de Estaciones">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@/images/map_pin.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button maxWidth="Infinity" prefHeight="45.0" text="Órdenes de Inspección" onAction="#handleVolverASeleccion">
                        <styleClass>
                            <String fx:value="menu-button" />
                            <String fx:value="menu-button-active" />
                        </styleClass>
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@/images/list.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button maxWidth="Infinity" onAction="#mostrarMensajeConstruccion" prefHeight="45.0" styleClass="menu-button" text="Mantenimiento">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@/images/maintenance.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button maxWidth="Infinity" onAction="#mostrarMensajeConstruccion" prefHeight="45.0" styleClass="menu-button" text="Reportes">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@/images/chart.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.3" />

                <VBox spacing="2" style="-fx-padding: 10 0 0 0;">
                    <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;" text="CONECTADO COMO:" />
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Agustín Bieber" />
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Region prefHeight="10" prefWidth="10" style="-fx-background-color: #2ecc71; -fx-background-radius: 50%;" />
                        <Label style="-fx-text-fill: #2ecc71; -fx-font-size: 12px;" text="En Línea" />
                    </HBox>
                </VBox>
            </VBox>
        </left>

        <center>
            <StackPane style="-fx-padding: 40;">

                <VBox fx:id="panelSeleccionOrden" spacing="20.0" styleClass="content-pane">
                    <Label styleClass="header-label" text="Órdenes Pendientes de Cierre" />
                    <Label styleClass="subtitle-label" text="Seleccione una orden de la lista para registrar su informe final." />

                    <ListView fx:id="listViewOrdenes" VBox.vgrow="ALWAYS" />


                    <HBox alignment="CENTER" spacing="40.0"> <Button fx:id="btnPagAnterior" onAction="#paginaAnterior" styleClass="pagination-button" text="◀ ANTERIOR" />

                        <Label fx:id="lblPagina" text="1 / 1" style="-fx-text-fill: #95a5a6; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                        <Button fx:id="btnPagSiguiente" onAction="#paginaSiguiente" styleClass="pagination-button" text="SIGUIENTE ▶" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT">
                        <Button fx:id="btnProcesar" onAction="#handleSeleccionarOrden" styleClass="action-button" text="Procesar Orden Seleccionada →" />
                    </HBox>
                </VBox>

                <VBox fx:id="panelFormularioCierre" spacing="15.0" styleClass="content-pane" visible="false" maxWidth="800">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Button onAction="#handleVolverASeleccion" styleClass="button-back-big" text="VOLVER">
                            <graphic>
                                <Label text="⬅" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                            </graphic>
                        </Button>                        <Separator orientation="VERTICAL" />
                        <Label fx:id="lblTituloOrden" styleClass="header-label" text="Informe de Cierre" />                    </HBox>
                    <Separator />

                    <VBox spacing="8.0" VBox.vgrow="NEVER">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="1. Observaciones del Técnico" />

                        <FlowPane fx:id="containerChips" hgap="10" vgap="10">
                            <Button onAction="#insertarTextoRapido" styleClass="quick-chip" text="Inspección OK" />
                            <Button onAction="#insertarTextoRapido" styleClass="quick-chip" text="Batería Reemplazada" />
                            <Button onAction="#insertarTextoRapido" styleClass="quick-chip" text="Limpieza" />

                            <Button onAction="#handleCrearNuevoChip" styleClass="quick-chip, quick-chip-add" text="+ Nuevo..." />
                        </FlowPane>

                        <TextArea fx:id="txtAreaObservacion" prefRowCount="3" promptText="Toque los botones o escriba aquí..." wrapText="true" />
                    </VBox>

                    <VBox spacing="8.0" alignment="CENTER"> <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="2. Estado del Sismógrafo" maxWidth="Infinity" alignment="CENTER_LEFT"/>

                        <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 10;">
                            <ToggleButton fx:id="btnEstadoOnline" onAction="#handleCambioEstadoSismografo" selected="true" styleClass="status-toggle, status-toggle-online" text="OPERATIVO">
                                <graphic>
                                    <ImageView fitHeight="40" fitWidth="40" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/check.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </ToggleButton>

                            <ToggleButton fx:id="btnEstadoOffline" onAction="#handleCambioEstadoSismografo" styleClass="status-toggle, status-toggle-offline" text="FUERA DE SERVICIO">
                                <graphic>
                                    <ImageView fitHeight="40" fitWidth="40" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/offline.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </ToggleButton>
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxMotivos" managed="false" spacing="10.0" styleClass="motivos-box" visible="false">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #d35400;" text="Indique la causa de la falla:" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <ComboBox fx:id="cmbMotivos"
                                      prefHeight="50.0"
                                      prefWidth="280.0"
                                      promptText="Seleccionar Motivo..."
                                      visibleRowCount="5" />

                            <TextField fx:id="txtComentarioMotivo"
                                       promptText="Escriba el detalle específico aquí..."
                                       HBox.hgrow="ALWAYS"
                                       prefHeight="50.0"
                                       style="-fx-font-size: 16px;" />

                            <Button onAction="#handleAgregarMotivo"
                                    prefHeight="50.0"
                                    prefWidth="100.0"
                                    style="-fx-background-color: #d35400; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"
                                    text="AÑADIR" />
                        </HBox>

                        <ListView fx:id="listViewMotivosAgregados" prefHeight="120.0" />
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="15.0">
                        <Button onAction="#handleConfirmacionFinal" styleClass="action-button" text="✔ Confirmar y Sincronizar" />
                    </HBox>
                </VBox>

                <VBox fx:id="panelDashboard" spacing="20.0" styleClass="content-pane" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-font-size: 40px;" text="📊" />
                        <VBox>
                            <Label styleClass="header-label" text="Monitor Central CCRS" />
                            <Label styleClass="subtitle-label" text="Registro de actividad de la Red Sísmica en tiempo real." />
                        </VBox>
                    </HBox>
                    <Separator />

                    <Label text="Últimas Alertas Recibidas:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ListView fx:id="listViewDashboard" VBox.vgrow="ALWAYS" styleClass="dashboard-list" style="-fx-background-color: #2c3e50; -fx-control-inner-background: #2c3e50;" />

                    <HBox alignment="CENTER_RIGHT">
                        <Button onAction="#handleVolverASeleccion" styleClass="button-back-big" text="VOLVER">
                            <graphic>
                                <Label text="⬅" style="-fx-font-size: 18px;"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

            </StackPane>
        </center>

    </BorderPane>

    <HBox fx:id="notificacionOverlay" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="toast-container" visible="false" StackPane.alignment="TOP_CENTER">
        <padding>
            <Insets bottom="20" />
        </padding>
        <HBox alignment="CENTER" spacing="10" styleClass="toast-content">
            <ImageView fx:id="imgIconoNotificacion" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" />            <VBox>
                <Label fx:id="lblTituloNotificacion" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px;" text="Modo Sin Conexión" />
                <Label fx:id="lblMensajeNotificacion" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" text="Los cambios se guardarán localmente." />
            </VBox>
        </HBox>
        <StackPane.margin>
            <Insets top="20.0" />
        </StackPane.margin>
    </HBox>

</StackPane>