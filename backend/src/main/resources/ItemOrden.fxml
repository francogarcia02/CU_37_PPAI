<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<HBox fx:id="cardContainer" alignment="CENTER_LEFT" spacing="15.0" styleClass="orden-card" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <StackPane>
        <Circle fx:id="iconBackground" fill="#f4f6f7" radius="28.0" stroke="#bdc3c7" strokeWidth="2.0" />

        <ImageView fx:id="imgIcono" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
        </ImageView>
    </StackPane>

    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="lblNombreEstacion" styleClass="card-title" text="Estación Volcán Lanín" />
            <Label fx:id="lblProvincia" style="-fx-background-color: #ecf0f1; -fx-text-fill: #7f8c8d; -fx-padding: 2 6; -fx-background-radius: 4; -fx-font-size: 10px;" text="NEUQUÉN" />
        </HBox>

        <Label fx:id="lblNumeroOrden" styleClass="card-subtitle" text="Orden #201" />

        <HBox alignment="CENTER_LEFT" spacing="5.0">
            <Label styleClass="card-detail" text="Sismógrafo:" />
            <Label fx:id="lblModelo" style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 12px;" text="ZETLAB-1" />
        </HBox>
    </VBox>

    <VBox alignment="CENTER_RIGHT" spacing="8.0">
        <Button fx:id="btnMapa" styleClass="btn-mapa" text="Ver Mapa">
            <graphic>
                <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true" mouseTransparent="true">
                    <image>
                        <Image url="@/images/maps.png" />
                    </image>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="Abrir ubicación en Google Maps" />
            </tooltip>
        </Button>

        <Label style="-fx-text-fill: #27ae60; -fx-font-size: 11px; -fx-font-weight: bold;" text="● LISTA PARA CIERRE" />
    </VBox>

</HBox>