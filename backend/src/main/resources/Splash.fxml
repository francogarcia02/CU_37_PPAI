<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: #2c3e50;"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="boundary.SplashController">
    <children>
        <Rectangle fill="#34495e" height="450.0" opacity="0.2" rotate="45.0" translateX="250" width="150.0" />

        <VBox alignment="CENTER" spacing="10.0">

            <VBox alignment="CENTER" spacing="2">
                <Label text="UNIVERSIDAD TECNOLÓGICA NACIONAL" textFill="#bdc3c7">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>
                <Label text="FACULTAD REGIONAL CÓRDOBA" textFill="#7f8c8d">
                    <font><Font name="Segoe UI" size="10.0" /></font>
                </Label>
            </VBox>

            <WebView fx:id="webViewAnimacion" prefHeight="250.0" prefWidth="400.0" maxWidth="500" />

            <VBox alignment="CENTER" maxWidth="400" spacing="5">
                <ProgressBar fx:id="progressBar" prefWidth="400.0" style="-fx-accent: #27ae60;" />
                <Label text="Cargando módulos del sistema..." textFill="#ecf0f1" style="-fx-font-size: 11px;"/>
            </VBox>

            <Region prefHeight="10.0" />

            <Label text="Grupo 13 - DSI 2025" textFill="#95a5a6">
                <font><Font size="10.0" /></font>
            </Label>
        </VBox>
    </children>
</StackPane>